                    "style": {
                      "borderRadius": "0.3rem",
                      "backgroundColor": "#78ff00"
                    }
                  },
                  "children": [
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Energy.current }}",
                        "style": {
                          "width": "2.4rem",
                          "--input-background-color": "#51aa0b"
                        }
                      },
                      "onChange": "game.data.Energy.current = value; chatLog('Energy changed to ' + value + ' (' + (delta > 0 ? '+' + delta : delta) + ')')"
                    }
                  ]
                }
              ]
            },
            "events": {
              "onStart": "if (game.turn.isMyTurn) { game.data.Energy.max = 1; game.data.Energy.current = game.data.Energy.max }",
              "onNewTurn": "if (game.turn.isMyTurn) { if (game.data.Energy.max < 6) { game.data.Energy.max = game.data.Energy.max + 1 }; game.data.Energy.current = game.data.Energy.max; chatLog('Energy restored to ' + game.data.Energy.current ) }"
