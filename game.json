            "displayedTitle": "Medawatch",
            "noQuickActions": true,
            "noAutoPayTo": true
          },
          "Energy": {
            "type": "custom",
            "defaultValue": {
              "current": 0,
              "max": 0
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "width": "3rem",
                  "height": "2rem",
                  "borderRadius": "0.3rem"
                },
                "className": "d-flex justify-content-between"
              },
              "children": [
                {
                  "type": "div",
                  "props": {
                    "className": "d-flex gap-2 align-items-center",
                    "style": {
                      "borderRadius": "0.3rem",
                      "backgroundColor": "#78ff00"
                    }
                  },
                  "children": [
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Energy.current }}",
                        "style": {
                          "width": "2.4rem",
                          "--input-background-color": "#51aa0b"
                        }
                      },
                      "onChange": "game.data.Energy.current = Number(value); functions.chatLog('Energy changed to ' + value + ' (' + deltaDisplay + ')')"
                    }
                  ]
                }
              ]
            },
            "events": {
              "onNewTurn": "if (game.turn.isMyTurn) { game.data.Energy.max = Math.min(game.data.Energy.max + 1, 6); game.data.Energy.current = game.data.Energy.max; if(game.turn.count > 1 && game.data.Energy.current < 2) game.data.Energy.current = 2; functions.chatLog('Energy restored to ' + game.data.Energy.current ) }"
            }
          }
        }
      }
